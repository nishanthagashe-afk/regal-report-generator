# Aparanji — environment variables
# Copy to your host's environment settings (do NOT commit real values).

# REQUIRED in production — long random string used to sign login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# REQUIRED to use the admin console (/admin.html). Long random string.
ADMIN_KEY=

# Marks the environment as production (enforces SESSION_SECRET, etc.)
NODE_ENV=production

# Where customer data, KYC uploads and generated PDFs are stored.
# Point this at a mounted persistent disk so records survive redeploys.
DATA_DIR=/data

# Port the server listens on (most hosts set this automatically).
PORT=3000

# ── OTP delivery (needed for real customer logins) ───────────────────────────
# Email (SMTP) — used for email OTPs:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS gateway (JSON webhook) — used for mobile OTPs.
# Must accept POST { to, message } with Authorization: Bearer <SMS_API_KEY>.
SMS_GATEWAY_URL=
SMS_API_KEY=

# Testing only — echoes OTP codes in API responses. NEVER set in production.
# OTP_DEBUG=1
